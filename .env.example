# ---------------------------------------------------------------------------
# BOTLatch environment template
# Copy to .env.local (web app) and .env (contracts/scripts). Never commit real values.
# ---------------------------------------------------------------------------

# --- Network -----------------------------------------------------------------
# Verify the chain id before deploying:  cast chain-id --rpc-url "$BOT_RPC_URL"  -> 677
BOT_RPC_URL=https://rpc.botchain.ai
BOT_CHAIN_ID=677
BOT_EXPLORER_URL=https://scan.botchain.ai
BOT_ESCROW_ADDRESS=

# Client-readable mirrors (safe: addresses and public endpoints only)
NEXT_PUBLIC_BOT_RPC_URL=https://rpc.botchain.ai
NEXT_PUBLIC_BOT_CHAIN_ID=677
NEXT_PUBLIC_BOT_EXPLORER_URL=https://scan.botchain.ai
NEXT_PUBLIC_BOT_ESCROW_ADDRESS=

# --- Deployment only — never expose to the web client -------------------------
DEPLOYER_PRIVATE_KEY=
# Optional. Owner of the deployed escrow (can rotate the verifier signer and pause).
# Defaults to the deployer address. Prefer a multisig or a cold key you do not keep on a server.
ESCROW_OWNER=

# --- Verifier server only — holds no customer funds, only signs decisions -----
# Public address of this key must equal the contract's verifierSigner.
# `npm run contracts:deploy` derives that address from this key; set VERIFIER_SIGNER
# instead only if the signing key lives somewhere this machine cannot read.
VERIFIER_PRIVATE_KEY=
VERIFIER_SIGNER=

# --- AI provider, server only -------------------------------------------------
# Anthropic-compatible by default. See packages/verifier/src/llm.ts.
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_BASE_URL=https://api.anthropic.com
LLM_TIMEOUT_MS=20000

# --- Storage ------------------------------------------------------------------
# Leave DATABASE_URL empty to use the local file store at .data/botlatch.json
DATABASE_URL=
APP_URL=http://localhost:3000

# Shared secret guarding internal routes (/api/jobs/:id/evaluate, /api/cron/tick)
INTERNAL_API_SECRET=change-me-in-production
